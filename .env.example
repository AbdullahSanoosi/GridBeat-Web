# Copy to .env.local and fill in real values (.env.local is gitignored).
# Mirrors lib/core/constants/app_constants.dart in the Flutter app.

# Public — safe to expose client-side
NEXT_PUBLIC_STATS_API_BASE_URL=https://f1stats.5928104.xyz
NEXT_PUBLIC_LIVE_API_BASE_URL=https://api.5928104.xyz
NEXT_PUBLIC_LIVE_WS_URL=wss://api.5928104.xyz/ws
NEXT_PUBLIC_ERGAST_BASE_URL=https://api.jolpi.ca/ergast/f1
NEXT_PUBLIC_OPENF1_BASE_URL=https://api.openf1.org/v1
NEXT_PUBLIC_CURRENT_SEASON=2026

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose without the NEXT_PUBLIC_ prefix, read only inside
# app/api/* route handlers. This is the twitterapi.io key: it was hardcoded
# client-side in the Flutter app (flagged insecure in its own source comment);
# the whole point of the /api/x-posts proxy route is to keep it server-side here.
TWITTER_API_KEY=
