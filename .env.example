# Copy to .env.local and fill in real values (.env.local is gitignored).
# Mirrors lib/core/constants/app_constants.dart in the Flutter app.

# Public — safe to expose client-side
NEXT_PUBLIC_STATS_API_BASE_URL=https://f1stats.5928104.xyz
NEXT_PUBLIC_LIVE_API_BASE_URL=https://api.5928104.xyz
NEXT_PUBLIC_LIVE_WS_URL=wss://api.5928104.xyz/ws
NEXT_PUBLIC_ERGAST_BASE_URL=https://api.jolpi.ca/ergast/f1
NEXT_PUBLIC_OPENF1_BASE_URL=https://api.openf1.org/v1
NEXT_PUBLIC_CURRENT_SEASON=2026
NEXT_PUBLIC_SITE_URL=https://dashboard.gridbeat.app

# Homepage developer-access (paid API/WSS) section. The section is BUILT AND
# VISIBLE by default so it can be reviewed; set this to "true" to hide it for
# the first public release.
NEXT_PUBLIC_API_ACCESS_HIDDEN=false
# Optional external enrollment form/link, used only when the section is enabled.
NEXT_PUBLIC_API_ENROLLMENT_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dev-only backend switcher (src/lib/dev/dev-store.ts, src/components/dev/backend-panel.tsx)
# — lets you and Sajjad flip the live-timing page to the replay backend from
# inside the dashboard. NEXT_PUBLIC_ENABLE_DEV_CONTROLS must be the literal
# string "true" to compile the panel in at all; leave it unset/"false" for
# any build that's meant to be public-facing — this is what actually keeps
# it out of that bundle, not the fact that nobody knows the URL. The other
# two only matter when it's on. No token var here on purpose — the replay
# control API's shared secret is typed into the panel itself and kept only
# in that browser's localStorage, never baked into a JS bundle.
NEXT_PUBLIC_ENABLE_DEV_CONTROLS=true
NEXT_PUBLIC_REPLAY_API_BASE_URL=https://test.5928104.xyz
NEXT_PUBLIC_REPLAY_WS_URL=wss://test.5928104.xyz/ws

# Server-only — never expose without the NEXT_PUBLIC_ prefix, read only inside
# app/api/* route handlers. This is the twitterapi.io key: it was hardcoded
# client-side in the Flutter app (flagged insecure in its own source comment);
# the whole point of the /api/x-posts proxy route is to keep it server-side here.
TWITTER_API_KEY=
